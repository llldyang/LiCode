providers:
  - name: Claude
    protocol: anthropic
    model: claude-sonnet-4-5
    api_key: "请填写 Anthropic API 密钥"
    # base_url: https://api.anthropic.com
    thinking: true
    # context_window 单位 token，可选；未配置时按 protocol 默认（anthropic 200000、openai 128000）。
    context_window: 200000

  # - name: OpenAI
  #   protocol: openai
  #   model: gpt-5-mini
  #   api_key: "请填写 OpenAI API 密钥"
  #   base_url: https://api.openai.com/v1
  #   context_window: 128000

# 指令文件按项目根 LiCode.md、项目 .Licode/LiCode.md、用户 ~/.Licode/LiCode.md
# 的顺序加载，前者优先级更高。
# .Licode/sessions/ 保存可由 /resume 恢复的对话；.Licode/memory/ 保存项目长期记忆。
# ~/.Licode/memory/ 保存跨项目通用的用户长期记忆。

# Team Fork 与 Coordinator Mode 默认关闭；Coordinator 还需环境变量双锁开启。
features:
  coordinator_mode: false
  fork_teammate: false
